[Unit]
Description=Recallo API Server
After=network.target postgres.service
Requires=postgres.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/recallo
EnvironmentFile=/opt/recallo/.env
ExecStart=/opt/recallo/bin/recallo
Restart=always
RestartSec=5s
StandardOutput=journal
StandardError=journal
TimeoutStopSec=25s
KillSignal=SIGTERM
KillMode=process
LimitNOFILE=65536
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
